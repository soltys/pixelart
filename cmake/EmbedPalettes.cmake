# cmake -DPALETTE_DIR=<dir> -DOUT=<file.h> -P EmbedPalettes.cmake
#
# Turns every <dir>/*.txt into a NUL-terminated byte array and writes a
# table of them, so pixelart.exe carries all bundled palettes inside itself.
# Bytes rather than string literals: palette keys include '"' and '\'.
file(GLOB files "${PALETTE_DIR}/*.txt")
list(SORT files)
set(arrays "")
set(table "")
set(count 0)
foreach(f IN LISTS files)
    get_filename_component(name "${f}" NAME_WE)
    string(MAKE_C_IDENTIFIER "pal_${name}" id)
    file(READ "${f}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REPEAT "0x..," 24 row) # CMake regexes have no {n}
    string(REGEX REPLACE "(${row})" "\\1\n    " hex "${hex}")
    string(APPEND arrays "static const char ${id}[] = {\n    ${hex}0x00};\n")
    string(APPEND table "    {\"${name}\", ${id}},\n")
    math(EXPR count "${count} + 1")
endforeach()
set(content "/* Generated by cmake/EmbedPalettes.cmake from the .txt files in palettes/. Do not edit. */\n")
string(APPEND content "${arrays}\n")
string(APPEND content "#define EMBEDDED_PALETTE_COUNT ${count}\n")
string(APPEND content "static const struct { const char *name; const char *text; } EMBEDDED_PALETTES[] = {\n${table}};\n")
# Only touch the header when it changes, so unrelated builds stay incremental.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
